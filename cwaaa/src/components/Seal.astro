---
/**
 * Seal.astro — the CWAAA coalition seal (design.md §9). Owner-supplied
 * medallion artwork (CW-G01, 2026-09-15): struck navy-and-gold rim, maroon
 * enamel field, the aerosol under the strike bar, LATHER · RINSE · RESPECT
 * on the lower rim. This replaces the interim SVG line-work. The object is
 * a photographed strike, not a flat logo: it keeps its own color on both
 * the ivory field and the ink masthead.
 */
import { getImage } from 'astro:assets';
import seal from '../assets/cwaaalogo-tight.png';
import { org } from '../content/copy';
interface Props { size?: number; decorative?: boolean; class?: string }
const { size = 44, decorative = false, class: className } = Astro.props;

/* Rendered at 40–50px in chrome; derivatives cover 2x and 3x displays. */
const widths = [44, 50, 88, 100, 132, 150, 200, 300];
const [avif, webp] = await Promise.all([
  getImage({ src: seal, widths, format: 'avif' }),
  getImage({ src: seal, widths, format: 'webp' }),
]);
const fallback = await getImage({ src: seal, width: 150, format: 'png' });
---
<picture class:list={['seal', className]}>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={`${size}px`} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={`${size}px`} />
  <img
    src={fallback.src}
    width={size}
    height={size}
    alt={decorative ? '' : org.sealAlt}
    aria-hidden={decorative ? 'true' : undefined}
    loading="eager"
    decoding="async"
  />
</picture>

<style>
  .seal { display: inline-flex; flex: none; }
  .seal img { display: block; width: 100%; height: auto; }
</style>
