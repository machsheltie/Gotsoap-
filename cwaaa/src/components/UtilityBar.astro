---
/**
 * UtilityBar.astro — slim pinned strip (approved home comp D, 2026-09-14):
 * the scale line and the pledge action. The pledge stays a document action.
 */
import { org, nav } from '../content/copy';
---
<div class="util on-ink" role="region" aria-label="Coalition">
  <p class="scale t-ui-caps">{org.scaleShort}</p>
  <a class="go t-ui" href={nav.pledge.href}>{nav.pledge.label} · {nav.pledge.form}</a>
</div>

<style>
  .util {
    position: sticky; top: 0; z-index: 40;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 0.6rem var(--gutter);
    background: var(--cw-ink); color: var(--cw-ivory);
  }
  .scale { margin: 0; font-family: var(--font-cwaaa-interface); font-weight: 500; }
  .go { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.25rem; white-space: nowrap;
    box-shadow: inset 0 -2px 0 var(--cw-ivory); }
  .go:hover { text-decoration: none; box-shadow: inset 0 -2px 0 var(--cw-tint); color: var(--cw-white); }
  /* Desktop: the primary navigation already carries Take the Pledge while the
     hero is on screen, so the bar's copy appears only once the nav has scrolled
     away (html.nav-away is set by scripts/reveal.ts). Phones keep it always. */
  @media (max-width: 900px) { .scale { display: none; } }
  @media (min-width: 1001px) {
    .go { opacity: 0; visibility: hidden; transform: translateY(-4px);
      transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), visibility 0s linear var(--dur); }
    :global(html.nav-away) .go { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    :global(html:not(.has-js)) .go { opacity: 1; visibility: visible; transform: none; }
  }
  @media (max-width: 900px) { .util { justify-content: flex-start; padding-block: 0.15rem; } }
</style>
