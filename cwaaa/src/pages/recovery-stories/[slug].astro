---
/**
 * /recovery-stories/[slug] — one opened story. This is the only place
 * Recovery Record and RC-NNN appear (design.md §4). The page is his: his
 * photograph, his testimony at reading scale, and the three participant-owned
 * facts. The Coalition speaks once, at the end, about its own handling —
 * never a verdict on the man (design.md §5: "told through his own character
 * rather than an institutional verdict"). No police-evidence furniture.
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { recoveryStories as r } from '../../content/copy';
import braydenObject from '../../assets/brayden.png';

export function getStaticPaths() {
  return r.stories.map((s) => ({ params: { slug: s.slug }, props: { story: s } }));
}
type Story = (typeof r.stories)[number];
const { story } = Astro.props as { story: Story };
const images: Record<string, ImageMetadata> = { brayden: braydenObject };
const img = images[story.slug];
---
<BaseLayout
  title={`${story.name} — Recovery Stories — CWAAA`}
  description={story.pull}
  current="/recovery-stories"
>
  <article class="story">
    <header class="head">
      <a class="back t-ui-caps" href="/recovery-stories">{r.backLabel}</a>
      <h1 class="who" data-reveal>{story.name}</h1>
    </header>

    <div class="left">
      <div class="shot-wrap" data-reveal="photo">
      {img ? (
        <ImageSlot
          class="shot" tone="field" id={story.id} title={story.name} spec=""
          image={img} alt={'alt' in story.image ? story.image.alt : ''}
          position="50% 40%" sizes="(max-width: 860px) 100vw, 46vw" priority
        />
      ) : (
        <ImageSlot
          class="shot" tone="field" id={story.id}
          title={`${story.name} · participant photograph`}
          spec={'spec' in story.image ? story.image.spec : ''} safe="10% 8%"
        />
      )}
      </div>

      <aside class="record" data-reveal style="--i: 3" aria-label={r.recordLabel}>
        <div class="rule ink"></div>
        <p class="rlabel t-ui-caps">{r.recordLabel} <span class="rid">{story.id}</span></p>
        <p class="disp t-ui">{story.disposition}</p>
      </aside>
    </div>

    <div class="right">
      <blockquote class="testimony" data-reveal style="--i: 1"><p>{story.testimony}</p></blockquote>

      <dl class="arc" data-reveal style="--i: 2">
        <div><dt class="t-ui-caps">{r.labels.believed}</dt><dd>{story.believed}</dd></div>
        <div><dt class="t-ui-caps">{r.labels.cost}</dt><dd>{story.cost}</dd></div>
        <div><dt class="t-ui-caps">{r.labels.changed}</dt><dd class="now">{story.changed}</dd></div>
      </dl>
    </div>

    <nav class="next" aria-label="Recovery Stories">
      <a class="act" href={r.action.href}><b>{r.action.label}</b><span class="t-ui-caps">{r.action.note}</span></a>
      <a class="all t-ui-caps" href="/recovery-stories">{r.backLabel}</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .story {
    background: var(--cw-white); padding: var(--section) var(--gutter);
    max-width: 78rem; margin: 0 auto;
    display: grid; grid-template-columns: 46% 1fr; gap: 0 var(--gap-l);
    align-items: start;
  }
  .head { grid-column: 1 / -1; margin-bottom: var(--gap-m); }
  .back { color: var(--cw-grey); text-decoration: none; border-bottom: 1px solid var(--cw-hairline); }
  .back:hover { color: var(--cw-ink); border-color: var(--cw-ink); text-decoration: none; }
  .who {
    font-family: var(--font-cwaaa-testimony); font-style: italic; font-weight: 400;
    font-size: var(--cw-statement); line-height: 1.1; color: var(--cw-ink);
    margin: var(--gap-s) 0 0;
  }
  /* Two real columns: his photograph and the Coalition's record on the left,
     his testimony and the arc on the right. The record filling the left column
     is what keeps a long quote from either stretching the photograph or leaving
     a void beneath it. */
  .left, .right { min-width: 0; }
  .shot-wrap :global(.shot) { aspect-ratio: 4 / 3; }
  .testimony { margin: 0; }
  .testimony p {
    font-family: var(--font-cwaaa-testimony); font-style: italic;
    font-size: var(--cw-testimony); line-height: 1.38; color: var(--cw-black);
    max-width: 34ch; margin: 0;
  }
  .arc { margin: var(--gap-l) 0 0; display: grid; gap: 1.15rem; max-width: 40ch; }
  .arc dt { color: var(--cw-grey); }
  .arc dd { margin: 0.3rem 0 0; font-size: var(--cw-text); line-height: 1.45; color: var(--cw-black); }
  .arc .now { color: var(--cw-ink); font-weight: 600; }
  .record { margin: var(--gap-m) 0 0; max-width: 40ch; }
  .rule.ink { height: 1.5px; background: var(--cw-ink); margin-bottom: 0.9rem; }
  .rlabel { color: var(--cw-ink); margin: 0; }
  .rid { font-family: var(--font-cwaaa-interface); letter-spacing: 0.06em; }
  .disp { color: var(--cw-grey); margin: 0.45rem 0 0; line-height: 1.5; }
  .next {
    grid-column: 1 / -1; margin-top: var(--section);
    display: flex; align-items: center; gap: var(--gap-m); flex-wrap: wrap;
  }
  .act {
    display: inline-flex; align-items: baseline; gap: 0.9rem;
    border: 1.5px solid var(--cw-stamp); color: var(--cw-stamp);
    padding: 1rem 1.4rem; min-height: 44px; text-decoration: none;
    font-family: var(--font-cwaaa-interface);
  }
  .act b { font-weight: 600; font-size: var(--cw-text); }
  .act span { color: var(--cw-grey); }
  .act:hover { background: var(--cw-stamp); color: var(--cw-ivory); text-decoration: none; }
  .act:hover span { color: rgba(245, 240, 230, 0.8); }
  .all { color: var(--cw-grey); text-decoration: none; border-bottom: 1px solid var(--cw-hairline); }
  .all:hover { color: var(--cw-ink); border-color: var(--cw-ink); text-decoration: none; }

  @media (max-width: 860px) {
    .story { grid-template-columns: 1fr; gap: 0; }
    .shot-wrap { margin-bottom: var(--gap-m); }
    .testimony p, .arc, .record { max-width: none; }
  }
</style>
