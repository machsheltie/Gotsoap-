---
/**
 * /recovery-stories/[id] — one opened record. Brief: .impeccable/surfaces/
 * cwaaa-src-pages-recovery-stories-astro.md (confirmed 2026-09-15).
 *
 * Order is the brief's, and it is the man's own order: masthead carrying
 * RECOVERY RECORD · RC-NNN (the identifier's first and only legal appearance,
 * design.md 4), then the referral as received, then his photograph retained as
 * received, then his testimony in Modest — the widest, quietest field on the
 * site — then the sparse chronology, then the outcome and next action, then the
 * pager. A record with an after-state places its follow-up photograph after the
 * reporting party's follow-up statement and before the closing fields, in the
 * same 4:3 frame as the first.
 *
 * `getStaticPaths` emits EVERY record, public or not; the index maps only the
 * public ones. Pagination walks the whole sequence, so the last public record's
 * Next loads Billy Bob and is never disabled. That divergence is the entire
 * mechanic (docs/canon-billy-bob-and-the-archive-boundary.md) and must not be
 * refactored away by a future tidy-up. There is no count in the pager: a count
 * would tell the visitor exactly where the boundary is. No secret-area
 * treatment — the site's mistake is bureaucratic, not theatrical.
 *
 * Brayden's testimony is owner-authored and ratified; nothing follows its last
 * line. The fielded close resumes only after a rule.
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { recoveryStories as r } from '../../content/copy';
import braydenPhoto from '../../assets/brayden.png';
import billyBobPhoto from '../../assets/billybob.png';
import billyBobAfter from '../../assets/billybob2.png';

/**
 * Every record whose file is actually written is emitted, public or not; the
 * index maps only the public ones. A record carrying testimony but no authored
 * referral, chronology or outcome (`open: false`) has no page at all — its
 * voice reads in full on the index instead. A masthead over an empty field is
 * not a record, and three blind readers read four of them as a broken site.
 * Pagination walks the emitted sequence in order, so the last public record's
 * Next still loads Billy Bob and is never disabled. That divergence remains
 * the mechanic (docs/canon-billy-bob-and-the-archive-boundary.md).
 */
export function getStaticPaths() {
  const written = r.records.filter((rec) => rec.open);
  return written.map((rec, i) => ({
    params: { id: rec.slug },
    props: {
      rec,
      prev: i > 0 ? written[i - 1] : null,
      next: i < written.length - 1 ? written[i + 1] : null,
    },
  }));
}

type Rec = (typeof r.records)[number];
const { rec, prev, next } = Astro.props as { rec: Rec; prev: Rec | null; next: Rec | null };
const photos: Record<string, ImageMetadata> = { brayden: braydenPhoto, 'billy-bob': billyBobPhoto };
const photo = photos[rec.slug];
/** The after-state, where a record has one. Same frame as the photograph above. */
const afterPhotos: Record<string, ImageMetadata> = { 'billy-bob': billyBobAfter };
const afterPhoto = afterPhotos[rec.slug];
const followUpImage = 'followUpImage' in rec && afterPhoto ? rec.followUpImage : null;

const arc = 'arc' in rec ? rec.arc : null;
const referral = 'referral' in rec ? rec.referral : null;
const corroboration = 'corroboration' in rec ? rec.corroboration : null;
const statements = 'statements' in rec ? rec.statements : null;
const testimony = 'testimony' in rec ? rec.testimony : null;
const fieldNote = 'fieldNote' in rec ? rec.fieldNote : null;
const chronology = 'chronology' in rec ? rec.chronology : null;
const requested = 'requested' in rec ? rec.requested : null;
const fragment = 'fragment' in rec ? rec.fragment : null;
const returned = 'returned' in rec ? rec.returned : null;
const followUp = 'followUp' in rec ? rec.followUp : null;
const partnerFollowUp = 'partnerFollowUp' in rec ? rec.partnerFollowUp : null;
const close = 'close' in rec ? rec.close : null;
const closeNote = 'closeNote' in rec ? rec.closeNote : null;

/** Statements carry their own paragraph breaks. */
const paras = (body: string) => body.split('\n\n');
---
<BaseLayout
  title={`${rec.name} — Recovery Stories — CWAAA`}
  description={`Recovery Record ${rec.id}. Documented by Concerned Women Against Axe Abuse.`}
  current="/recovery-stories"
>
  <article class="rec">
    <header class="masthead">
      <p class="rid t-ui-caps" data-reveal>{r.recordLabel} <span class="sep" aria-hidden="true">·</span> <span class="num">{rec.id}</span></p>
      <h1 class="who t-voice-h" data-reveal style="--i: 1">{rec.name}</h1>
    </header>

    {/* The record's conversion argument, ahead of any proof. Three beats only. */}
    {arc && (
      <section class="arc" aria-label="Summary">
        <dl class="fields" data-reveal>
          {arc.map((f) => (
            <div><dt class="t-ui-caps t-label">{f.label}</dt><dd class="t-ui">{f.value}</dd></div>
          ))}
        </dl>
      </section>
    )}

    {referral && (
      <section class="referral" aria-labelledby="ref-h">
        <h2 id="ref-h" class="sec-label t-ui-caps t-label" data-reveal>{r.referralLabel}</h2>
        <dl class="fields" data-reveal style="--i: 1">
          {referral.map((f) => (
            <div><dt class="t-ui-caps t-label">{f.label}</dt><dd class="t-ui">{f.value}</dd></div>
          ))}
        </dl>
        {corroboration && (
          <div class="corrob" data-reveal style="--i: 2">
            {corroboration.map((block) => (
              <div class="corrob-block">
                <h3 class="corrob-h sec-label t-ui-caps">{block.heading}</h3>
                <dl class="fields">
                  {block.rows.map((f) => (
                    <div><dt class="t-ui-caps t-label">{f.label}</dt><dd class="t-ui">{f.value}</dd></div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    {statements && statements.map((st) => (
      <section class="statement">
        <h2 class="sec-label t-ui-caps t-label" data-reveal>{st.heading}</h2>
        {paras(st.body).map((para, n) => <p class="st-b" data-reveal style={`--i: ${n + 1}`}>{para}</p>)}
      </section>
    ))}

    <div class="shot-wrap" data-reveal="photo">
      {photo ? (
        <ImageSlot
          class="shot" tone="field" id="Participant photograph" title={rec.name} spec=""
          image={photo} alt={'alt' in rec.image ? rec.image.alt : ''}
          ratio="4 / 3" position="50% 38%" sizes="(max-width: 860px) 100vw, 36rem"
        />
      ) : (
        <ImageSlot
          class="shot" tone="field" id="CW-G04" title={rec.name}
          spec={'spec' in rec.image ? rec.image.spec : ''} safe="10% 8%" ratio="4 / 3"
          pendingNote={r.noPhoto}
        />
      )}
    </div>

    {testimony && testimony.length > 0 && (
      <blockquote class="testimony">
        {testimony.map((para, n) => <p data-reveal style={`--i: ${Math.min(n, 3)}`}>{para}</p>)}
      </blockquote>
    )}

    {chronology && (
      <section class="chronology" aria-labelledby="chr-h">
        <div class="rule ink" data-reveal="rule"></div>
        <h2 id="chr-h" class="sec-label t-ui-caps t-label" data-reveal style="--i: 1">{r.chronologyLabel}</h2>
        <dl class="fields" data-reveal style="--i: 2">
          {chronology.map((f) => (
            <div class:list={['visit' in f && f.visit ? 'visit' : null]}><dt class="t-ui-caps t-label">{f.label}</dt><dd class="t-ui">{f.value}</dd></div>
          ))}
        </dl>
      </section>
    )}

    {fieldNote && (
      <section class="statement">
        <h2 class="sec-label t-ui-caps t-label" data-reveal>{fieldNote.heading}</h2>
        {paras(fieldNote.body).map((para, n) => <p class="st-b" data-reveal style={`--i: ${n + 1}`}>{para}</p>)}
      </section>
    )}

    {/* CWAAA asked, and CWAAA knows the case came back. It never says what happened between. */}
    {requested && (
      <p class="returned t-ui-caps" data-reveal>{requested.label} — <span class="nb">{requested.value}</span></p>
    )}

    {fragment && (
      /* A foreign object, not a CWAAA component: stark white, Courier, black,
         its own reference numbering, small. Unlinked, uncaptioned, unexplained.
         The withheld disposition is a solid bar — a redaction is an act done to
         a document; brackets read as a field somebody forgot to fill in. The
         lines are real text, so a screen reader hears the same document a
         sighted visitor sees; only the bar needs a name. */
      <div class="fragment">
        <pre>{fragment.lines.join('\n')}</pre>
        <p class="disp"><span>{fragment.dispositionLabel}</span><i class="bar" role="img" aria-label="redacted"></i></p>
      </div>
    )}

    {returned && (
      <p class="returned t-ui-caps" data-reveal>{returned.label} — <span class="nb">{returned.value}</span></p>
    )}

    {followUp && (
      <section class="follow" aria-labelledby="fu-h">
        <h2 id="fu-h" class="sec-label t-ui-caps t-label" data-reveal>{followUp.heading}</h2>
        {followUp.lines.map((line) => <p class="fu-l t-note" data-reveal style="--i: 1">{line}</p>)}
        <p class="fu-lead t-note" data-reveal style="--i: 2">{followUp.askedLead}</p>
        <p class="fu-q t-testimony" data-reveal style="--i: 3">{followUp.quote}</p>
      </section>
    )}

    {partnerFollowUp && (
      <section class="statement">
        <h2 class="sec-label t-ui-caps t-label" data-reveal>{partnerFollowUp.heading}</h2>
        {paras(partnerFollowUp.body).map((para, n) => <p class="st-b" data-reveal style={`--i: ${n + 1}`}>{para}</p>)}
      </section>
    )}

    {/* The evidence follows her statement and precedes the close. Same 4:3
        frame as the photograph retained as received, so the two states of one
        man are compared on the record's terms. */}
    {followUpImage && (
      <figure class="shot-wrap follow-shot" data-reveal="photo">
        <ImageSlot
          class="shot" tone="field" id="Follow-up photograph" title={rec.name} spec=""
          image={afterPhoto} alt={followUpImage.alt}
          ratio="4 / 3" position="50% 40%" sizes="(max-width: 860px) 100vw, 36rem"
        />
        <figcaption class="shot-cap t-note">{followUpImage.caption}</figcaption>
      </figure>
    )}

    {close && (
      <section class="close-fields" aria-label="Case record">
        <div class="rule ink" data-reveal="rule"></div>
        <dl class="fields" data-reveal style="--i: 1">
          {close.map((f) => (
            <div><dt class="t-ui-caps t-label">{f.label}</dt><dd class="t-ui">{f.value}</dd></div>
          ))}
        </dl>
        {closeNote && <p class="close-note t-note" data-reveal style="--i: 2">{closeNote}</p>}
      </section>
    )}

    <!-- The pledge is always the ruled row (owner decision, Option A, 2026-09-15). -->
    <div class="act-wrap" data-reveal>
      <div class="actions">
        <a class="primary" href={r.action.href}>{r.action.label} <span class="n">{r.action.note}</span></a>
      </div>
    </div>

    <!-- No count: a count tells the visitor where the boundary is.
         The last written record renders no Next. That is record 7 being
         unwritten, NOT the archive ending there (canon: "Build status,
         2026-09-15"). Never point Next at a record that does not exist — a 404
         reads as a broken site and gives the visitor an innocent explanation
         for the boundary they just crossed. Appending record 7 to the sequence
         restores this link with no change here. -->
    <nav class="pager" aria-label="Recovery records" data-reveal>
      {prev
        ? <a class="p-prev t-ui-caps t-label" href={`/recovery-stories/${prev.slug}`}>← {r.pager.prev}</a>
        : <span class="p-prev empty"></span>}
      <a class="p-all t-ui-caps t-label" href="/recovery-stories">{r.pager.all}</a>
      {next
        ? <a class="p-next t-ui-caps t-label" href={`/recovery-stories/${next.slug}`}>{r.pager.next} →</a>
        : <span class="p-next empty"></span>}
    </nav>
  </article>
</BaseLayout>

<style>
  /* The opened record's page shell. Not the `.record` component in system.css:
     that name is the filed label/value block, and this is a reading surface. */
  .rec {
    /* The reading edge. Every block the visitor READS — statements, testimony,
       follow-up, the pledge row — stops here, so the record has one right edge
       rather than five. It is the testimony's --cw-measure at the top of its
       size clamp (46ch of Modest at 30px), fixed in rem so the smaller blocks
       under it share the edge instead of each computing a different one from
       their own font. The photograph keeps its own 36rem cap (owner direction
       2026-09-17: an exhibit, not a hero) and the Office fragment stays small
       because it is a foreign object; the fields are the fracture. */
    --rec-edge: 39.25rem;
    /* The fracture's depth (see .fields below). It lives in the shell's own
       left padding, so the labels break the reading column's margin and never
       the white column's edge. */
    --fracture: 4.5rem;
    background: var(--cw-white);
    padding: var(--section) var(--gutter) var(--section) calc(var(--gutter) + var(--fracture));
    max-width: var(--cw-shell); margin: 0 auto;
  }
  .masthead { margin-bottom: var(--gap-l); }
  .rid { color: var(--cw-ink); margin: 0; }
  .rid .sep { color: var(--cw-grey); margin: 0 0.1em; }
  .rid .num { font-family: var(--font-cwaaa-interface); letter-spacing: 0.06em; }
  /* A date never breaks across a line: "March / 11, 2026" read as two fields. */
  .nb { white-space: nowrap; }
  .who { margin: var(--gap-s) 0 0; }
  .rule.ink { margin: 0 0 var(--gap-m); }

  /* The single authored fracture: field labels intrude into the reading
     column's left margin. This is deliberately NOT the `.record` component —
     that block rules top and bottom and reads across; this one breaks the
     reading column, and unifying them would delete the route's one departure.

     The intrusion is INSIDE the white column. `.rec` reserves the fracture's
     depth in its own left padding and the labels hang back into it, so the
     brief's sentence is what renders: the labels break the reading column's
     left margin, not the card's edge. An earlier build let them cross the
     white column onto the ivory, which at 1280–1536 wide read as text
     falling off the left of a centred card while the right third of a 62rem
     column carried nothing (critique 2026-09-18). It also depended on the
     centring margin existing, which produced a partial-fracture band from
     861px to 1108px and an `overflow-x: clip` hazard below it. Neither can
     recur: the room is padding, present at every width above --bp-reading.

     One right edge. `.fields` stops at --rec-edge like every reading block;
     the row's negative margin extends it leftward only, so values never run
     past the testimony's edge the way they did when the grid took `1fr` of
     the whole column.

     The label column is 17rem: at 15rem the longest labels ("Participant's
     stated position", "Cleansing on non-working days", "Additional CWAAA
     intervention") broke to two lines against one-line values. */
  .fields { margin: 0; display: grid; gap: 0.55rem; max-width: var(--rec-edge); }
  .fields > div {
    display: grid; grid-template-columns: 17rem 1fr; gap: 1rem;
    align-items: baseline;
    margin-left: calc(-1 * var(--fracture));
  }
  /* A visit boundary in the chronology. Billy Bob's file restates the same
     position three times because there were three visits; without a break the
     repetition read as a typo. A hairline opens each visit after the first,
     and the ink rule stays where it is — this separates, it does not close. */
  .fields > div.visit { border-top: 1px solid var(--cw-hairline); padding-top: 0.75rem; margin-top: 0.35rem; }
  .fields dd { margin: 0; color: var(--cw-black); }

  .referral { margin-bottom: var(--gap-l); }
  .corrob { margin-top: var(--gap-m); display: grid; gap: var(--gap-m); }
  /* The second label tier is `.sec-label` (system.css). Only the colour differs
     here: a corroboration heading is the record's own voice, so it takes ink by
     omitting `.t-label` rather than becoming a third class. */
  .corrob-h { color: var(--cw-ink); }

  .statement { margin: 0 0 var(--gap-l); max-width: var(--rec-edge); }

  /* These section labels are real headings (h2, and h3 inside the referral
     section) so a screen-reader user can move through a record: before this
     the whole of Brayden's file exposed h1 plus a single h2. Nothing moves on
     screen — `.t-ui-caps` carries the face, size, weight and casing and
     `.sec-label` the margin — but base.css balances heading text, and these
     were paragraphs, so the paragraph's own wrapping is put back rather than
     letting a caps label re-break. */
  .rec .sec-label { text-wrap: pretty; }
  .st-b {
    font-family: var(--font-cwaaa-testimony); font-size: var(--cw-text);
    line-height: 1.55; color: var(--cw-black); margin: 0 0 0.9rem;
  }
  .st-b:last-child { margin-bottom: 0; }

  /* A record photograph is an exhibit clipped to the file, not a hero: it stops
     at the testimony's measure rather than the full reading column. Owner
     direction 2026-09-17 — both frames were running over 900px on a laptop. */
  .shot-wrap { margin: 0 0 var(--gap-l); max-width: 36rem; }
  /* The after photograph carries the route's one caption: notation under the
     frame, not a headline over it. The reveal rides the same photo timing. */
  .follow-shot { padding: 0; }
  .shot-cap { margin: 0.7rem 0 0; }

  /* The widest, quietest field on the site. */
  .testimony { margin: 0 0 var(--gap-l); padding: 0; border: 0; }
  .testimony p {
    font-family: var(--font-cwaaa-testimony); font-size: var(--cw-testimony);
    line-height: 1.5; color: var(--cw-black); margin: 0 0 1.1rem;
    max-width: min(var(--cw-measure), var(--rec-edge));
  }
  .testimony p:last-child { margin-bottom: 0; }

  .chronology, .close-fields { margin: 0 0 var(--gap-l); }
  /* Face, size, colour and measure all come from `.t-note`. */
  .close-note { margin: var(--gap-m) 0 0; }

  .fragment {
    background: #ffffff; border: 1px solid #15181f; color: #000000;
    padding: 1.1rem 1.25rem; margin: 0 0 var(--gap-m);
    max-width: 30rem; font-size: 0.75rem;
  }
  .fragment pre {
    font-family: 'Courier New', Courier, monospace; font-size: 0.75rem; line-height: 1.5;
    margin: 0; white-space: pre-wrap; color: #000000;
  }
  .fragment .disp {
    font-family: 'Courier New', Courier, monospace; font-size: 0.75rem; line-height: 1.5;
    margin: 0; display: flex; align-items: center; gap: 0.5rem; color: #000000;
  }
  .fragment .bar { display: block; flex: 1; max-width: 13rem; height: 0.85rem; background: #000000; }

  .arc { margin: 0 0 var(--gap-l); }
  .returned { color: var(--cw-ink); margin: 0 0 var(--gap-l); }

  .follow { margin: 0 0 var(--gap-l); max-width: var(--rec-edge); }
  .follow .t-note { max-width: none; }
  .close-note { max-width: var(--rec-edge); }
  .fu-l { margin: 0 0 0.4rem; }
  .fu-lead { margin: var(--gap-m) 0 0.6rem; }
  .fu-q { margin: 0; }

  .act-wrap { margin: var(--section) 0 0; }
  /* The pledge sits on the reading edge, not an unrelated 460px — the same
     correction the index made when its close was rebuilt onto the entry grid. */
  .act-wrap .actions { max-width: var(--rec-edge); }

  .pager {
    max-width: var(--rec-edge);
    margin-top: var(--gap-l); padding-top: var(--gap-m);
    border-top: 1px solid var(--cw-hairline);
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center;
  }
  .pager a {
    position: relative;
    color: var(--cw-ink); text-decoration: none; border-bottom: 1px solid var(--cw-hairline);
  }
  .pager a:hover { border-color: var(--cw-ink); text-decoration: none; }
  /* Target size (WCAG 2.2 AA, 2.5.8). These were the route's only sub-24px
     targets — a 20px line of quiet notation. They stay a 20px line of quiet
     notation: a box, pill or padded button would make the pager louder than
     the record it walks. Only the hit area grows, as a transparent overlay
     centred on the line box, so the hairline keeps sitting on the text
     instead of floating at the bottom of an enlarged box. */
  .pager a::after {
    content: ''; position: absolute; left: 0; right: 0;
    top: 50%; height: 44px; transform: translateY(-50%);
  }
  .p-next { text-align: right; justify-self: end; }
  .p-all { justify-self: center; color: var(--cw-grey); }
  .empty { display: block; }

  /* ---- --bp-reading: the intruding labels give up the margin ---------------- */
  @media (max-width: 860px) {
    .rec { padding-left: var(--gutter); }
    .fields > div { grid-template-columns: 1fr; gap: 0.15rem; margin-left: 0; }
    .fields > div.visit { padding-top: 0.9rem; margin-top: 0.5rem; }
    .testimony p, .statement, .follow, .shot-wrap, .fields, .pager { max-width: none; }
    /* Stacked, the three links are 20px lines; 1.5rem of gap makes the row
       pitch exactly 44px, so the hit areas above meet edge to edge and never
       overlap. At 0.75rem they overlapped by 12px and a near miss on PREVIOUS
       would have opened ALL RECOVERY STORIES. */
    .pager { grid-template-columns: 1fr; text-align: left; gap: 1.5rem; }
    .p-next, .p-all { justify-self: start; text-align: left; }
    .empty { display: none; }
  }

  /* ---- --bp-phone: fixed-width blocks give up their widths ------------------
     The record reads in one column well before this, but three things are still
     sized for a desktop: the quoted Office fragment (30rem), the pledge row
     (460px) and the label column inside it. On a 390px screen the fragment was
     the only element that could not fit, and `overflow-x: clip` would have
     taken the overflow silently. */
  @media (max-width: 700px) {
    .fragment { max-width: none; }
    .act-wrap .actions { max-width: none; }
    .rec { padding: var(--gap-l) var(--gutter); }
  }
</style>
