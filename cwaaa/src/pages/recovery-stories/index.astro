---
/**
 * /recovery-stories — the index. Intimate, individual, quiet, reading-oriented
 * (design.md §5). One participant-owned field per man, read as a column: his
 * photograph, his name, one line in his own words, and the way in. Deliberately
 * NOT a card grid, carousel, testimonial deck, mugshot wall or evidence board —
 * those make a participant look like a suspect (design.md, PRD route table).
 * RC-NNN is withheld here; it appears only inside an opened story (design.md §4).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { recoveryStories as r } from '../../content/copy';
import braydenObject from '../../assets/brayden.png';
import type { ImageMetadata } from 'astro';

const images: Record<string, ImageMetadata> = { brayden: braydenObject };
---
<BaseLayout title={r.meta.title} description={r.meta.description} current="/recovery-stories">
  <section class="lead" aria-labelledby="lead-h">
    <p class="marker" data-reveal>{r.marker}</p>
    <h1 id="lead-h" class="heading" data-reveal style="--i: 1">{r.heading}</h1>
    <div class="rule" data-reveal="rule" style="--i: 2"></div>
    <p class="intro t-lead" data-reveal style="--i: 2">{r.intro}</p>
    <p class="note t-ui" data-reveal style="--i: 3">{r.note}</p>
  </section>

  <ol class="stories">
    {r.stories.map((s, i) => (
      <li class="story" data-reveal>
        <a class="cover" href={`/recovery-stories/${s.slug}`} aria-labelledby={`n-${s.slug}`}>
          {images[s.slug] ? (
            <ImageSlot
              class="shot" tone="field" id="Participant photograph" title={s.name}
              spec="" image={images[s.slug]} alt={'alt' in s.image ? s.image.alt : ''}
              position="50% 40%" sizes="(max-width: 860px) 100vw, 38vw"
            />
          ) : (
            /* No RC-NNN on the index: the identifier belongs only to an opened
               story (design.md §4). The placeholder names the man, not the record. */
            <ImageSlot
              class="shot" tone="field" id="Photograph pending"
              title={s.name}
              spec={'spec' in s.image ? s.image.spec : ''} safe="10% 8%"
            />
          )}
          <div class="say">
            <p class="pull" aria-hidden="true">{s.pull}</p>
            <p id={`n-${s.slug}`} class="who t-ui-caps">{s.name}</p>
            <span class="go t-ui-caps">{r.readLabel}</span>
          </div>
        </a>
      </li>
    ))}
  </ol>

  <section class="close">
    <div class="rule ink" data-reveal="rule"></div>
    <a class="act" href={r.action.href} data-reveal style="--i: 1">
      <b>{r.action.label}</b><span class="t-ui-caps">{r.action.note}</span>
    </a>
  </section>
</BaseLayout>

<style>
  .lead { background: var(--cw-ivory); padding: var(--section) var(--gutter) var(--gap-l); }
  .heading {
    font-family: var(--font-cwaaa-testimony); font-style: italic; font-weight: 400;
    font-size: var(--cw-statement); line-height: 1.12; color: var(--cw-ink);
    max-width: 18ch; margin: var(--gap-s) 0 0;
  }
  .rule { height: 1px; background: var(--cw-hairline); margin: var(--gap-m) 0; }
  .rule.ink { background: var(--cw-ink); height: 1.5px; }
  .intro { color: var(--cw-black); margin: 0; }
  .note { color: var(--cw-grey); margin: var(--gap-s) 0 0; max-width: 52ch; }

  .stories { list-style: none; margin: 0; padding: 0; background: var(--cw-white); }
  .story + .story { border-top: 1px solid var(--cw-hairline); }
  .cover {
    display: grid; grid-template-columns: 38% 1fr; gap: var(--gap-l); align-items: center;
    padding: var(--gap-l) var(--gutter); text-decoration: none; color: inherit;
    transition: background var(--dur, 0.3s) var(--ease-out, ease);
  }
  .cover:hover { background: var(--cw-ivory); text-decoration: none; }
  .cover :global(.shot) { aspect-ratio: 4 / 3; }
  .pull {
    font-family: var(--font-cwaaa-testimony); font-style: italic;
    font-size: var(--cw-testimony); line-height: 1.3; color: var(--cw-ink);
    margin: 0; max-width: 20ch;
  }
  .who { color: var(--cw-grey); margin: 1.1rem 0 0; }
  .go {
    display: inline-block; margin-top: 1.1rem; color: var(--cw-ink);
    border-bottom: 1.5px solid var(--cw-ink); padding-bottom: 2px;
  }
  .cover:hover .go { color: var(--cw-black); border-color: var(--cw-black); }

  .close { background: var(--cw-ivory); padding: var(--gap-l) var(--gutter) var(--section); }
  .act {
    display: inline-flex; align-items: baseline; gap: 0.9rem; margin-top: var(--gap-m);
    border: 1.5px solid var(--cw-stamp); color: var(--cw-stamp);
    padding: 1rem 1.4rem; min-height: 44px; text-decoration: none;
    font-family: var(--font-cwaaa-interface);
  }
  .act b { font-weight: 600; font-size: var(--cw-text); }
  .act span { color: var(--cw-grey); }
  .act:hover { background: var(--cw-stamp); color: var(--cw-ivory); text-decoration: none; }
  .act:hover span { color: rgba(245, 240, 230, 0.8); }

  @media (max-width: 860px) {
    .cover { grid-template-columns: 1fr; gap: var(--gap-m); }
    .pull { max-width: none; }
  }
</style>
