---
/**
 * DownloadStation.astro — shared download primitive (§5.2 allows sharing).
 *
 * Consumes psas.downloadNotice from the copy module verbatim; the download
 * target is the untouched full-quality original behind /downloads/ (PRD §6.2).
 * Deliberately layout-passive: typography only, no positioning — each
 * environment decides where the station sits inside ITS composition.
 */
import Button from '../Button.astro';
import { psas } from '../../content/copy';

interface Props {
  slug: string;
  downloadHref: string;
}
const { slug, downloadHref } = Astro.props;
const notice = psas.downloadNotice;
---

<section class="download-station">
  <!-- Phase 4 consensus (F15): the full distribution notice renders ONCE on
       the /psas index; detail stations carry the chrome-short line only.
       PSA close-out (2026-07-30): the station HEADING is index-only too —
       here it literally duplicated the button label ("Take one for the
       wall"), and the ×5 display-type repeat smothered each page's body
       closer. The button carries the phrase; the compact line stays. -->
  <p class="download-body">{notice.compact}</p>
  <Button
    label={notice.button}
    href={downloadHref}
    download={`got-soap-${slug}.jpg`}
  />
</section>

<style>
  .download-body {
    font-family: var(--font-production);
    font-size: var(--step--1);
    line-height: 1.6;
    opacity: 0.78;
    max-inline-size: 44ch;
    margin-block-end: var(--space-md);
  }
</style>
