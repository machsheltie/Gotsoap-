---
/**
 * homev2/Case.astro — SECTION 2: THE CASE — **The Porcelain Evidence Wall** (§3.2).
 *
 * The crisis staged as filed evidence on a wet, high-key ceramic wall. All
 * five findings sit in ONE compact object: a staggered row of small glazed
 * evidence stamps, each one tile module wide, set on the grout grid beneath
 * the ledger plaque (owner direction 2026-09-18: statistics stay, but small
 * and together — never a billboard-scale bulk of the page).
 *
 * The manifesto (the demand) runs across the tile joints in its own live-type
 * zone — staggered lines stepped by whole tile units, never a centered column.
 * Campaign register (🧼) only.
 *
 * COPY: findings, tags, heading, subnote, demand, creed, and the route label
 * are VERBATIM from `crisis` / `home.case` in copy.ts (the demand is copy.ts's
 * documented reassembly of "soap, applied to men, regularly",
 * crisis.founding[1] — moved out of this markup in the 2026-07-16
 * hardcoded-copy sweep).
 */
import { crisis, home } from '../../content/copy';

// The design lift of the number already inside each verbatim finding line,
// keyed by the tag suffix. Findings and tags themselves render verbatim.
const lifts: Record<string, string> = {
  "26-01": "87%",
  "26-02": "9/10",
  "26-03": "0%",
  "26-04": "73%",
  "26-05": "4.7 yr",
};
---

<section id="case" class="case register-porcelain" aria-labelledby="case-manifesto">
  <div class="case__tile" aria-hidden="true"></div>
  <div class="case__wet" aria-hidden="true"></div>
  <span class="case__grain fx-grain" aria-hidden="true"></span>

  <div class="case__wall">
    <!-- The emphasized grout line lives INSIDE the wall so the stamp row and
         the line share one coordinate space: the lock holds at every width,
         including wide viewports where the 82rem wall floats centered (the
         section-relative version separated by 230px at 1920 — Sol F7). -->
    <span class="case__groutline" aria-hidden="true"></span>
    <!-- The manifesto zone: the demand runs across the tile joints, stepped
         by whole tile units. Never a centered text column. -->
    <h2 id="case-manifesto" class="case__manifesto">
      <span class="case__demand case__demand--1">{home.case.demand[0]}</span>
      <span class="case__demand case__demand--2">{home.case.demand[1]}</span>
      <span class="case__demand case__demand--3">{home.case.demand[2]}</span>
    </h2>
    <p class="case__creed">{home.case.creed}</p>

    <!-- The ledger plaque: a small glazed placard screwed to the wall. -->
    <header class="case__plaque">
      <p class="case__plaque-title">{crisis.findings.heading}</p>
      <p class="case__plaque-note">{crisis.findings.subnote}</p>
    </header>

    <!-- THE STAMP ROW. Five small glazed evidence stamps, each one tile module
         wide, set in one staggered row on the grout grid. The figure is the
         design lift of the number already inside the verbatim line. -->
    <article class="case__stamps" data-reveal aria-label={crisis.findings.heading}>
      {crisis.findings.rows.map((r) => (
        <div class="case__stamp">
          <div class="case__plate">
            <p class="case__stamp-figure" aria-hidden="true">{lifts[r.tag.slice(-5)]}</p>
            <p class="case__stamp-tag">{r.tag}</p>
          </div>
          <p class="case__stamp-finding">{r.finding}</p>
        </div>
      ))}
    </article>

    <p class="case__more">
      <a class="case__link" href="/crisis">{home.case.cta} <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .case {
    /* One tile module drives the grout grid and the manifesto steps, so the
       type genuinely sits ON the wall's geometry. --rail-inset is the shared
       distance (in WALL space) from the wall's right edge to the emphasized
       grout line AND to the RAIL zone's right edge — one variable, one lock. */
    --tile: clamp(4.5rem, 11vw, 10rem);
    --rail-inset: clamp(0.6rem, 2.5vw, 1.5rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--steam-white);
    color: var(--grout-black);
    padding-block: clamp(4.5rem, 13vh, 9.5rem);
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }

  /* The ceramic: a true tile grid with fine grout joints. */
  .case__tile {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(var(--tile) - 1.5px),
        color-mix(in srgb, var(--grout-black) 11%, transparent) calc(var(--tile) - 1.5px),
        color-mix(in srgb, var(--grout-black) 11%, transparent) var(--tile)
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--tile) - 1.5px),
        color-mix(in srgb, var(--grout-black) 9%, transparent) calc(var(--tile) - 1.5px),
        color-mix(in srgb, var(--grout-black) 9%, transparent) var(--tile)
      );
  }
  /* The wet: specular blooms and one hard diagonal sheen across the glaze. */
  .case__wet {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        116deg,
        transparent 38%,
        color-mix(in srgb, var(--lather-white) 66%, transparent) 47%,
        color-mix(in srgb, var(--lather-white) 18%, transparent) 53%,
        transparent 62%
      ),
      radial-gradient(46% 34% at 12% 8%, color-mix(in srgb, var(--lather-white) 85%, transparent), transparent 65%),
      radial-gradient(40% 30% at 88% 82%, color-mix(in srgb, var(--lather-white) 55%, transparent), transparent 68%),
      radial-gradient(34% 26% at 64% 30%, color-mix(in srgb, var(--marble-amber) 7%, transparent), transparent 70%);
  }
  /* The emphasized right grout line the RAIL zone locks to. Positioned in
     the wall's coordinate space (the wall is the positioned parent). */
  .case__groutline {
    position: absolute;
    top: 0;
    bottom: 0;
    right: var(--rail-inset);
    width: 2.5px;
    z-index: 0;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--grout-black) 26%, transparent) 12%,
      color-mix(in srgb, var(--grout-black) 26%, transparent) 88%,
      transparent
    );
  }
  .case__grain {
    opacity: 0.05;
    mix-blend-mode: multiply;
  }

  .case__wall {
    position: relative;
    z-index: 1;
    max-width: 82rem;
    margin-inline: auto;
  }

  /* ---- The manifesto: across the tile joints, stepped by tile units ------ */
  .case__manifesto {
    display: flex;
    flex-direction: column;
    font-family: var(--font-command);
    font-weight: 700;
    font-size: clamp(2.75rem, 8.5vw, 7rem);
    /* ≥1.05: sub-1.0 display leading is the clipping class (home pass 2026-07-16);
       "Applied" and "Regularly" carry real descenders. */
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--grout-black);
  }
  .case__demand--2 {
    margin-left: calc(var(--tile) * 1);
    color: color-mix(in srgb, var(--grout-black) 76%, var(--steam-white));
  }
  .case__demand--3 {
    margin-left: calc(var(--tile) * 2.5);
    color: var(--marble-amber-ink);
  }
  .case__creed {
    font-family: var(--font-command);
    font-weight: 500;
    font-size: clamp(1.1rem, 2.2vw, 1.7rem);
    line-height: 1.2;
    color: color-mix(in srgb, var(--grout-black) 82%, var(--steam-white));
    max-width: 24ch;
    margin-top: clamp(1.25rem, 3vh, 2rem);
    margin-left: calc(var(--tile) * 0.5);
  }

  /* ---- The ledger plaque -------------------------------------------------- */
  .case__plaque {
    width: fit-content;
    max-width: 44rem;
    margin-top: clamp(3rem, 8vh, 5.5rem);
    padding: clamp(0.8rem, 1.6vw, 1.2rem) clamp(1rem, 2.2vw, 1.6rem);
    background: linear-gradient(180deg, color-mix(in srgb, #fff 70%, transparent), color-mix(in srgb, #fff 20%, transparent));
    border: 1px solid color-mix(in srgb, var(--grout-black) 20%, transparent);
    border-radius: var(--radius-tile);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 10px 26px -14px rgba(20, 16, 10, 0.4);
  }
  .case__plaque-title {
    font-family: var(--font-interface);
    font-weight: 500;
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--grout-black);
  }
  .case__plaque-note {
    font-family: var(--font-production);
    font-size: var(--step--2);
    line-height: 1.5;
    color: color-mix(in srgb, var(--grout-black) 62%, var(--steam-white));
    margin-top: 0.35rem;
  }

  /* ---- The stamp row ------------------------------------------------------
     Small glazed evidence stamps, one tile module each, staggered by a
     quarter tile on the even stamps so the row reads as hand-set on the grid. */
  .case__stamps {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 clamp(0.75rem, 1.5vw, 1rem);
    margin-top: clamp(1.5rem, 3vh, 2.25rem);
  }
  .case__stamp {
    flex: 1 1 11rem;
    max-width: 16rem;
    min-width: 0;
  }
  .case__stamp:nth-child(even) {
    margin-top: calc(var(--tile) * 0.25);
  }
  .case__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(var(--tile) * 0.9);
    min-height: 5.25rem;
    padding: 0.55rem 0.7rem 0.5rem;
    background: linear-gradient(180deg, color-mix(in srgb, #fff 72%, transparent), color-mix(in srgb, #fff 26%, transparent));
    border: 1px solid color-mix(in srgb, var(--grout-black) 28%, transparent);
    border-radius: var(--radius-tile);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.85) inset,
      0 8px 20px -12px rgba(20, 16, 10, 0.45);
  }
  .case__stamp-figure {
    font-family: var(--font-command);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--grout-black);
    white-space: nowrap;
  }
  .case__stamp-tag {
    font-family: var(--font-production);
    font-size: var(--step--2);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--grout-black) 52%, var(--steam-white));
    white-space: nowrap;
  }
  .case__stamp-finding {
    font-family: var(--font-command);
    font-weight: 500;
    font-size: clamp(0.92rem, 1.2vw, 1.05rem);
    line-height: 1.3;
    color: color-mix(in srgb, var(--grout-black) 88%, var(--steam-white));
    margin-top: 0.65rem;
    padding-right: 0.5rem;
  }

  /* ---- Route ---------------------------------------------------------------- */
  .case__more {
    margin-top: clamp(3rem, 7vh, 4.5rem);
  }
  .case__link {
    font-family: var(--font-interface);
    font-weight: 500;
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--marble-amber-ink);
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--marble-amber-ink) 40%, transparent);
    padding-bottom: 0.2em;
    transition: border-color 140ms ease;
  }
  .case__link:hover {
    border-bottom-color: var(--marble-amber-ink);
  }

  /* ---- Mobile: the tall wall (§3.2) ------------------------------------------
     The stamps pair up two per row; copy stays beneath its own stamp. */
  @media (max-width: 720px) {
    .case {
      /* tighter gutters so two stamps fit per row */
      padding-inline: clamp(1.1rem, 4.5vw, 1.5rem);
    }
    .case__demand--2 {
      margin-left: calc(var(--tile) * 0.66);
    }
    .case__demand--3 {
      margin-left: calc(var(--tile) * 1.5);
    }
    .case__creed {
      margin-left: 0;
    }

    /* STAMP ROW: two stamps per row; the stagger drops to a fixed step. */
    .case__stamps {
      gap: 0.9rem 0.75rem;
    }
    .case__stamp {
      flex: 0 0 calc(50% - 0.4rem);
      max-width: none;
    }
    .case__stamp:nth-child(even) {
      margin-top: 1.25rem;
    }
    .case__plate {
      height: auto;
      min-height: 4.5rem;
    }
  }

  /* §3.2/§6/§11: reduced motion resolves to the final composition — the wall
     simply stands lit; no hover transition. */
  @media (prefers-reduced-motion: reduce) {
    .case__link {
      transition: none;
    }
  }
</style>
